{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "BSPI Kaptai campus user profile storing identity, academic role, department, shift, semester, and bookmarked notices.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full display name of the campus member."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"],
          "description": "Academic role within CampusOS."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "BSPI Technology / Department name."
        },
        "shift": {
          "type": "string",
          "enum": ["1st Shift", "2nd Shift"],
          "description": "Preferred BSPI campus shift."
        },
        "semester": {
          "type": "string",
          "enum": [
            "1st Semester",
            "2nd Semester",
            "3rd Semester",
            "4th Semester",
            "5th Semester",
            "6th Semester",
            "7th Semester",
            "8th Semester"
          ],
          "description": "Current Diploma-in-Engineering semester."
        },
        "bookmarked_notices": {
          "type": "array",
          "description": "Notice document IDs bookmarked by the user (bounded at 100 items)."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200,
          "description": "Campus or personal email address."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        }
      },
      "required": ["uid", "full_name", "role", "department", "email", "created_at"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Official BSPI Kaptai announcement published by teachers or administrators.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Announcement headline."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Full notice body."
        },
        "category": {
          "type": "string",
          "enum": ["Academic", "Exam", "Admission", "Stipend/Upobritti", "General"],
          "description": "Official notice category."
        },
        "is_urgent": {
          "type": "boolean",
          "description": "Highlights time-sensitive notices such as exam routines or stipend deadlines."
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Author UID."
        },
        "author_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Denormalized author display name."
        },
        "author_role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"],
          "description": "Denormalized author role."
        },
        "author_department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Denormalized author department."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when notice was published."
        }
      },
      "required": [
        "title",
        "content",
        "created_by",
        "author_name",
        "author_role",
        "author_department",
        "created_at"
      ]
    },
    "Routine": {
      "title": "Routine",
      "description": "Scheduled BSPI Kaptai class routine slot organized by weekday, department, shift, and semester.",
      "type": "object",
      "properties": {
        "day": {
          "type": "string",
          "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Saturday", "Friday"],
          "description": "Weekday of the class."
        },
        "time_slot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Class time window (e.g., 08:00 AM - 08:45 AM)."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Course code and subject title."
        },
        "teacher_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Instructor name."
        },
        "room": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Classroom, workshop, or lab identifier."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "BSPI technology offering the class."
        },
        "shift": {
          "type": "string",
          "enum": ["1st Shift", "2nd Shift"],
          "description": "Academic shift (1st Shift morning or 2nd Shift afternoon)."
        },
        "semester": {
          "type": "string",
          "enum": [
            "1st Semester",
            "2nd Semester",
            "3rd Semester",
            "4th Semester",
            "5th Semester",
            "6th Semester",
            "7th Semester",
            "8th Semester"
          ],
          "description": "BTEB Diploma semester."
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of teacher or admin who added the slot."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when class slot was created."
        }
      },
      "required": [
        "day",
        "time_slot",
        "subject",
        "teacher_name",
        "room",
        "department",
        "created_by",
        "created_at"
      ]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "User profiles keyed by Firebase Auth UID."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Official BSPI Kaptai notices readable by signed-in members and managed by teachers/admins."
    },
    "/routines/{routineId}": {
      "schema": { "$ref": "#/entities/Routine" },
      "description": "Department, shift, and semester class routine slots readable by signed-in members and managed by teachers/admins."
    }
  }
}
